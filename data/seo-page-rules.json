{
  "version": 1,
  "categories": [
    "hostel",
    "library",
    "tiffin",
    "cafe",
    "bookstore"
  ],
  "rules": {
    "cityHub": {
      "minListings": 10
    },
    "cityCategory": {
      "minListings": 5,
      "minVerified": 0
    },
    "areaCategory": {
      "minListings": 3,
      "minVerified": 1,
      "needsAreaProfile": true
    },
    "areaHub": {
      "minListings": 6,
      "minCategories": 3,
      "needsAreaProfile": true
    },
    "studentCitiesHub": {
      "minCities": 1
    }
  },
  "demotion": {
    "buffer": 2,
    "graceDays": 30
  },
  "policy": {
    "newIneligiblePage": "omit",
    "previouslyIndexedBelowThreshold": "noindex-follow-for-grace-then-301-to-parent",
    "sitemap": "index-only",
    "internalLinks": "index-only"
  }
}
